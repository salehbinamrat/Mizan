<Window x:Class="MizanMedical.Desktop.FirstRunWindow" 
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ميزان الطبي — التهيئة الأولى للمسؤول" Width="640" Height="700"
        MinWidth="610" MinHeight="600" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft"
        Background="{StaticResource MedicalCanvas}" FontFamily="Segoe UI">
    <Grid Margin="24">
        <Border Style="{StaticResource MedicalCard}" CornerRadius="18" Padding="29">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Image Source="pack://application:,,,/Assets/MizanMedical-UI.png" Width="78" Height="78" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="تهيئة مسؤول البرنامج لأول مرة"
                               FontSize="23" FontWeight="Bold" TextAlignment="Center"
                               Foreground="{StaticResource MedicalNavy}" Margin="0,7,0,8"/>
                    <TextBlock Text="يستخدم هذا المعالج على جهاز الخادم فقط ولمرة واحدة. لا يوجد حساب مدير أو كلمة مرور افتراضية."
                               TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{StaticResource MedicalMuted}" Margin="0,0,0,20"/>
                    <TextBlock Text="رمز التهيئة المؤقت المعروض على شاشة الخادم" FontWeight="SemiBold" Margin="3,0,0,5"/>
                    <PasswordBox x:Name="PairingCodeBox" MinHeight="42" Padding="10,7"
                                 FlowDirection="LeftToRight" Margin="0,0,0,12"/>
                    <TextBlock Text="اسم المستشفى (سيُستخدم عند تسجيل دخول جميع الموظفين)"
                               FontWeight="SemiBold" TextWrapping="Wrap" Margin="3,0,0,5"/>
                    <TextBox x:Name="HospitalNameBox" MaxLength="200" Margin="0,0,0,12"/>
                    <TextBlock Text="اسم مسؤول البرنامج" FontWeight="SemiBold" Margin="3,0,0,5"/>
                    <TextBox x:Name="FullNameBox" MaxLength="200" Margin="0,0,0,12"/>
                    <TextBlock Text="اسم المستخدم (حروف إنجليزية وأرقام)" FontWeight="SemiBold" Margin="3,0,0,5"/>
                    <TextBox x:Name="UsernameBox" MaxLength="80" FlowDirection="LeftToRight" Margin="0,0,0,12"/>
                    <TextBlock Text="كلمة المرور الرئيسية (12 حرفا على الأقل)" FontWeight="SemiBold" Margin="3,0,0,5"/>
                    <PasswordBox x:Name="PasswordBox" MinHeight="42" Padding="10,7"
                                 FlowDirection="LeftToRight" Margin="0,0,0,12"/>
                    <TextBlock Text="تأكيد كلمة المرور" FontWeight="SemiBold" Margin="3,0,0,5"/>
                    <PasswordBox x:Name="ConfirmPasswordBox" MinHeight="42" Padding="10,7"
                                 FlowDirection="LeftToRight" Margin="0,0,0,12"/>
                    <TextBlock x:Name="ErrorText" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{StaticResource MedicalDanger}" Margin="3,0,3,8"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="CreateButton" Content="إنشاء الحساب الرئيسي"
                                Click="Create_Click" MinWidth="220" Height="45"/>
                        <Button Content="إلغاء" Click="Cancel_Click" MinWidth="120"
                                Background="#64768B" Height="45"/>
                    </StackPanel>
                    <TextBlock Text="بعد نجاح التهيئة يُبطل رمز الإعداد، وتدار حسابات الموظفين من لوحة المسؤول فقط."
                               Foreground="#456A76" FontSize="12" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="0,15,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>MizanMedical.Desktop</AssemblyName>
    <ApplicationIcon>Assets\MizanMedical.ico</ApplicationIcon>
    <Title>ميزان الطبي</Title>
    <Product>ميزان الطبي</Product>
    <Description>النظام المالي المركزي للمستشفى</Description>
    <RootNamespace>MizanMedical.Desktop</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../MizanMedical.Domain/MizanMedical.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="mizan-client.json" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets\MizanMedical.ico" />
    <Resource Include="Assets\MizanMedical-UI.png" />
  </ItemGroup>
</Project>

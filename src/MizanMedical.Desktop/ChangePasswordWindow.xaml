<Window x:Class="MizanMedical.Desktop.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        
        Title="ميزان الطبي — تغيير كلمة المرور" Width="540" Height="490"
        MinWidth="540" MinHeight="490" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft"
        Background="{StaticResource MedicalCanvas}" FontFamily="Segoe UI">
    <Grid Margin="23">
        <Border Style="{StaticResource MedicalCard}" CornerRadius="18" Padding="26">
            <StackPanel>
                <TextBlock Text="حماية الحساب" Foreground="{StaticResource MedicalNavy}"
                           FontWeight="Bold" FontSize="23" Margin="0,0,0,7"/>
                <TextBlock Text="سيتم إغلاق جميع جلسات دخولك بعد تغيير كلمة المرور."
                           TextWrapping="Wrap" Margin="0,0,0,17"
                           Foreground="{StaticResource MedicalMuted}"/>
                <TextBlock Text="كلمة المرور الحالية" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <PasswordBox x:Name="CurrentPasswordBox" Padding="10,7" FlowDirection="LeftToRight" Margin="0,0,0,13"/>
                <TextBlock Text="كلمة المرور الجديدة (12 حرفا على الأقل)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <PasswordBox x:Name="NewPasswordBox" Padding="10,7" FlowDirection="LeftToRight" Margin="0,0,0,13"/>
                <TextBlock Text="تأكيد كلمة المرور الجديدة" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <PasswordBox x:Name="ConfirmPasswordBox" Padding="10,7" FlowDirection="LeftToRight" Margin="0,0,0,13"/>
                <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{StaticResource MedicalDanger}" Margin="0,0,0,9"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="SaveButton" Content="حفظ كلمة المرور" Click="Save_Click" Width="190"/>
                    <Button Content="إلغاء" Click="Cancel_Click" Background="#63758A" Width="110"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>

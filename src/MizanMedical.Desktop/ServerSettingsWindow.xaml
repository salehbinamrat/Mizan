<Window x:Class="MizanMedical.Desktop.ServerSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ميزان الطبي — إعداد الاتصال" Width="610" Height="545"
        MinWidth="580" MinHeight="515" WindowStartupLocation="CenterOwner"
        
        FlowDirection="RightToLeft" Background="{StaticResource MedicalCanvas}">
    <Border Style="{StaticResource MedicalCard}" Margin="22" Padding="24">
        <StackPanel>
            <TextBlock Text="عنوان خادم المستشفى" FontSize="23" FontWeight="Bold"
                       Foreground="{StaticResource MedicalNavy}" Margin="0,0,0,12"/>
            <TextBlock Text="البرنامج يحتاج خادم ميزان الطبي API وقاعدة PostgreSQL. أدخل عنوان الخادم المركزي مع البورت. لا تدخل اسم المستخدم أو كلمة المرور هنا."
                       TextWrapping="Wrap" Foreground="{StaticResource MedicalMuted}"
                       Margin="0,0,0,13"/>
            <TextBlock Text="وضع التشغيل — دون حاجة لاتصال الإنترنت" FontWeight="Bold" Margin="0,0,0,7"/>
            <StackPanel Margin="0,0,0,12">
                <RadioButton x:Name="SingleMachineMode" GroupName="ConnectionMode"
                             Content="جهاز واحد: الخادم وقاعدة البيانات على هذا الكمبيوتر"
                             Checked="Mode_Checked" Margin="0,0,0,8"/>
                <RadioButton x:Name="LanMode" GroupName="ConnectionMode"
                             Content="شبكة محلية سلكية LAN: خادم داخل المستشفى"
                             Checked="Mode_Checked"/>
            </StackPanel>
            <TextBlock Text="عنوان خادم الشبكة (مثال فقط: https://192.168.1.10:5081)"
                       FontWeight="SemiBold"/>
            <TextBox x:Name="AddressBox" MinHeight="42" FlowDirection="LeftToRight"
                     HorizontalContentAlignment="Left" Margin="0,3,0,11"/>
            <TextBlock Text="شبكة LAN لا تحتاج إنترنت، لكنها تتطلب HTTPS بشهادة داخلية موثوقة. يجب تثبيت الخادم وقاعدة البيانات أولا، ولا يُعطّل التحقق من الشهادة."
                       TextWrapping="Wrap" Foreground="{StaticResource MedicalWarning}"
                       Margin="0,0,0,13"/>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="TestButton" Content="فحص الاتصال" Click="Test_Click"
                        Width="132" Background="#216B84"/>
                <Button Content="حفظ العنوان" Click="Save_Click" Width="132"/>
                <Button Content="إلغاء" Click="Cancel_Click" Width="90"
                        Background="#788698"/>
            </StackPanel>
            <TextBlock x:Name="ResultText" TextWrapping="Wrap"
                       Foreground="{StaticResource MedicalNavy}" Margin="3,14,0,0"/>
        </StackPanel>
    </Border>
</Window>

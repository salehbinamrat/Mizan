<Window x:Class="MizanMedical.Desktop.LoginWindow" Icon="pack://application:,,,/Assets/MizanMedical.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ميزان الطبي — الدخول الموحد" Width="650" Height="656"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        FlowDirection="RightToLeft" Background="{StaticResource MedicalCanvas}"
        FontFamily="Segoe UI" Loaded="Window_Loaded" KeyDown="Window_KeyDown">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource MedicalNavy}" CornerRadius="17" Padding="24">
            <StackPanel HorizontalAlignment="Center">
                <Image Source="pack://application:,,,/Assets/MizanMedical-UI.png" Width="86" Height="86" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                <TextBlock Text="ميزان الطبي" Foreground="White" FontSize="29" FontWeight="Bold" TextAlignment="Center"/>
                <TextBlock Text="النظام المالي المركزي للمستشفى" Foreground="#C8E1E8" FontSize="14" TextAlignment="Center"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource MedicalCard}" CornerRadius="17" Padding="35" Margin="0,16,0,0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="تسجيل الدخول" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource MedicalNavy}" TextAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="واجهة موحدة للمديرين ومسؤولي الأقسام وجميع الموظفين"
                           Foreground="{StaticResource MedicalMuted}" FontSize="13"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,22"/>
                <TextBlock Text="اسم المستخدم" FontWeight="SemiBold" Margin="4,0,0,6"/>
                <TextBox x:Name="UsernameBox" FlowDirection="LeftToRight" MaxLength="80"
                         HorizontalContentAlignment="Left" Margin="0,0,0,16"/>
                <TextBlock Text="كلمة المرور" FontWeight="SemiBold" Margin="4,0,0,6"/>
                <PasswordBox x:Name="PasswordBox" FlowDirection="LeftToRight"
                             Padding="12,8" Margin="0,0,0,20" MinHeight="41"/>
                <Button x:Name="LoginButton" Content="تسجيل الدخول"
                        Click="Login_Click" Height="48" FontSize="16" FontWeight="Bold" Margin="0,0,0,9"/>
                <Button x:Name="FirstSetupButton" Content="تهيئة حساب مسؤول البرنامج لأول مرة"
                        Visibility="Collapsed" Click="FirstSetup_Click"
                        Background="#176653" Height="41" Margin="0,2,0,9"/>
                <TextBlock x:Name="StatusText" TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{StaticResource MedicalDanger}" Margin="0,6,0,10"
                           AutomationProperties.LiveSetting="Polite"/>
                <Border Background="#EAF6F4" CornerRadius="10" Padding="14" Margin="0,6,0,0">
                    <StackPanel>
                        <TextBlock Text="القسم والصلاحيات يحددهما مسؤول البرنامج"
                                   Foreground="#176653" FontWeight="SemiBold" TextAlignment="Center"/>
                        <TextBlock Text="بعد تسجيل الدخول تُعرض لك صفحاتك وصندوقك الشخصي فقط بحسب التفويض."
                                   Foreground="#456A76" FontSize="12" TextAlignment="Center"
                                   TextWrapping="Wrap" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>

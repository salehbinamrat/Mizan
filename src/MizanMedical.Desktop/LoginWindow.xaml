<Window x:Class="MizanMedical.Desktop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ميزان الطبي — تسجيل الدخول" Width="500" Height="520"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" FlowDirection="RightToLeft"
        Background="#F0F5F8" FontFamily="Segoe UI">
    <Grid Margin="38">
        <Border Background="White" CornerRadius="18" Padding="33" BorderBrush="#D8E5EC" BorderThickness="1">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="✚" FontSize="46" Foreground="#086A80" HorizontalAlignment="Center"/>
                <TextBlock Text="ميزان الطبي" FontSize="31" FontWeight="Bold" Foreground="#103C52" HorizontalAlignment="Center" Margin="0,6,0,2"/>
                <TextBlock Text="نظام الإدارة المالية للمستشفى" FontSize="14" Foreground="#667E8D" HorizontalAlignment="Center" Margin="0,0,0,24"/>
                <TextBlock Text="اسم المستخدم" FontWeight="SemiBold" Margin="4,0,0,6"/>
                <TextBox x:Name="UsernameBox" FlowDirection="LeftToRight"/>
                <TextBlock Text="كلمة المرور" FontWeight="SemiBold" Margin="4,18,0,6"/>
                <PasswordBox x:Name="PasswordBox" Padding="9" Height="39" Margin="4" FlowDirection="LeftToRight"/>
                <Button x:Name="LoginButton" Content="الدخول إلى النظام" Click="Login_Click" Margin="4,25,4,8" Height="45" FontWeight="SemiBold"/>
                <TextBlock x:Name="StatusText" TextAlignment="Center" TextWrapping="Wrap" Foreground="#A02E45" Margin="4,10,4,0"/>
                <TextBlock Text="اتصال آمن بخادم المستشفى الداخلي" HorizontalAlignment="Center" FontSize="12" Foreground="#76919F" Margin="0,20,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

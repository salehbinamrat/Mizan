<Window x:Class="MizanMedical.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ميزان الطبي — الإدارة المالية" Width="1380" Height="880" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="#F0F5F8" FontFamily="Segoe UI"
        FlowDirection="RightToLeft" Loaded="Window_Loaded">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#143F55" Height="94">
            <Grid Margin="26,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ميزان الطبي" Foreground="White" FontSize="29" FontWeight="Bold"/>
                    <TextBlock Text="النظام المالي المركزي للمستشفى | المرحلة الأولى" Foreground="#B7D2DC" FontSize="13"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="UserLabel" Foreground="White" FontSize="15" VerticalAlignment="Center" Margin="12,0"/>
                    <TextBlock Text="القسم النشط:" Foreground="White" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <ComboBox x:Name="ActiveDepartmentCombo" Width="170" Height="34"
                              DisplayMemberPath="Name" SelectedValuePath="Id" Margin="6"/>
                    <Button Content="تحديث القوائم" Click="Refresh_Click" Background="#227B8B"/>
                    <Button Content="تسجيل الخروج" Click="Logout_Click" Background="#A23B50"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border DockPanel.Dock="Bottom" Height="38" Background="#E2EDF2">
            <TextBlock x:Name="StatusLabel" VerticalAlignment="Center" Margin="20,0" Foreground="#31596B" Text="جاهز للعمل — جميع العمليات تحفظ في قاعدة البيانات المركزية."/>
        </Border>
        <TabControl x:Name="ModulesTabs" Margin="16" BorderBrush="#C8DCE4" Background="White">
            <TabItem x:Name="DashboardTab" Header="الرئيسية">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="25">
                        <TextBlock Text="ملخص النشاط المالي" FontSize="24" FontWeight="Bold" Foreground="#173F53" Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,20">
                            <TextBlock Text="تاريخ التقرير:" VerticalAlignment="Center" Margin="0,0,0,0"/>
                            <DatePicker x:Name="ReportDate" Width="175" Margin="10,0" Language="en-US"/>
                            <Button Content="عرض التقرير" Click="Report_Click"/>
                            <Button Content="حفظ CSV" Click="ExportCsv_Click" Background="#367B62"/>
                            <Button Content="طباعة / PDF" Click="PrintReport_Click" Background="#64768B"/>
                        </StackPanel>
                        <UniformGrid Columns="2" Rows="2">
                            <Border Margin="7" Padding="22" Background="#E9F6F9" CornerRadius="12">
                                <StackPanel><TextBlock Text="قيمة الفواتير الصادرة" Foreground="#396678"/>
                                    <TextBlock x:Name="InvoicedLabel" Text="—" FontSize="28" FontWeight="Bold" Foreground="#0B5A72" Margin="0,5"/></StackPanel>
                            </Border>
                            <Border Margin="7" Padding="22" Background="#ECF8F1" CornerRadius="12">
                                <StackPanel><TextBlock Text="المقبوضات النقدية" Foreground="#396678"/>
                                    <TextBlock x:Name="ReceivedLabel" Text="—" FontSize="28" FontWeight="Bold" Foreground="#176347" Margin="0,5"/></StackPanel>
                            </Border>
                            <Border Margin="7" Padding="22" Background="#FFF3EC" CornerRadius="12">
                                <StackPanel><TextBlock Text="المصروفات النقدية" Foreground="#396678"/>
                                    <TextBlock x:Name="SpentLabel" Text="—" FontSize="28" FontWeight="Bold" Foreground="#B16526" Margin="0,5"/></StackPanel>
                            </Border>
                            <Border Margin="7" Padding="22" Background="#EEF1FB" CornerRadius="12">
                                <StackPanel><TextBlock Text="صافي الحركة النقدية" Foreground="#396678"/>
                                    <TextBlock x:Name="NetLabel" Text="—" FontSize="28" FontWeight="Bold" Foreground="#324E8E" Margin="0,5"/></StackPanel>
                            </Border>
                        </UniformGrid>
                        <TextBlock x:Name="InvoiceCountLabel" Foreground="#31596B" FontWeight="SemiBold" Margin="8,18,0,2"/>
                        <TextBlock Text="ملاحظة: الفواتير تمثل مبيعات الخدمات، بينما التحصيل يمثل النقد المقبوض فعليا. هذا ملخص تشغيلي وليس قائمة أرباح وخسائر نهائية." TextWrapping="Wrap" Foreground="#607D8E" Margin="8,10"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="PatientsTab" Header="المرضى">
                <Grid Margin="19"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="سجل المرضى الأساسي" FontSize="22" FontWeight="Bold" Foreground="#173F53" Margin="0,0,0,15"/>
                    <StackPanel x:Name="PatientForm" Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="رقم الملف" VerticalAlignment="Center"/>
                        <TextBox x:Name="PatientFileBox" Width="165" FlowDirection="LeftToRight"/>
                        <TextBlock Text="اسم المريض" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        <TextBox x:Name="PatientNameBox" Width="255"/>
                        <Button Content="إضافة مريض" Click="AddPatient_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="PatientsGrid" Grid.Row="2" AutoGeneratingColumn="Grid_AutoGeneratingColumn"/>
                </Grid>
            </TabItem>
            <TabItem x:Name="ServicesTab" Header="الخدمات والأسعار">
                <Grid Margin="19"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="تعريف الخدمات الطبية وأسعارها" FontSize="22" FontWeight="Bold" Foreground="#173F53" Margin="0,0,0,15"/>
                    <WrapPanel x:Name="ServiceForm" Grid.Row="1" Margin="0,0,0,12">
                        <TextBlock Text="الرمز" VerticalAlignment="Center"/>
                        <TextBox x:Name="ServiceCodeBox" Width="105" FlowDirection="LeftToRight"/>
                        <TextBlock Text="الخدمة" VerticalAlignment="Center"/>
                        <TextBox x:Name="ServiceNameBox" Width="205"/>
                        <TextBlock Text="القسم: من الأعلى" VerticalAlignment="Center" Margin="8,0"/>
                        <TextBlock Text="السعر" VerticalAlignment="Center"/>
                        <TextBox x:Name="ServicePriceBox" Width="105" FlowDirection="LeftToRight" Language="en-US"/>
                        <Button Content="إضافة خدمة" Click="AddService_Click"/>
                    </WrapPanel>
                    <DataGrid x:Name="ServicesGrid" Grid.Row="2" AutoGeneratingColumn="Grid_AutoGeneratingColumn"/>
                </Grid>
            </TabItem>
            <TabItem x:Name="InvoicesTab" Header="الفواتير">
                <Grid Margin="19">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="إصدار فاتورة خدمات طبية" FontSize="22" FontWeight="Bold" Foreground="#173F53" Margin="0,0,0,12"/>
                    <StackPanel x:Name="InvoiceForm" Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="المريض" VerticalAlignment="Center"/>
                        <ComboBox x:Name="InvoicePatientCombo" Width="380" DisplayMemberPath="Display" SelectedValuePath="Id"/>
                        <TextBlock Text="الخدمة" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <ComboBox x:Name="InvoiceServiceCombo" Width="335" DisplayMemberPath="Display" SelectedValuePath="Id"/>
                    </StackPanel>
                    <StackPanel x:Name="InvoiceLineForm" Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="الكمية" VerticalAlignment="Center"/>
                        <TextBox x:Name="InvoiceQtyBox" Width="90" Text="1" FlowDirection="LeftToRight"/>
                        <Button Content="إضافة سطر" Click="AddInvoiceLine_Click"/>
                        <Button Content="حذف السطر المحدد" Click="RemoveInvoiceLine_Click" Background="#7A8095"/>
                        <Button Content="إصدار الفاتورة" Click="CreateInvoice_Click" Background="#1B755D"/>
                    </StackPanel>
                    <DataGrid x:Name="DraftLinesGrid" Grid.Row="3" Height="135" AutoGenerateColumns="True" AutoGeneratingColumn="Grid_AutoGeneratingColumn"/>
                    <GroupBox x:Name="InvoiceListGroup" Header="أحدث الفواتير" Grid.Row="4" Margin="0,12,0,0" FontWeight="SemiBold">
                        <DataGrid x:Name="InvoicesGrid" AutoGeneratingColumn="Grid_AutoGeneratingColumn"/>
                    </GroupBox>
                </Grid>
            </TabItem>
            <TabItem x:Name="CashTab" Header="الصندوق والمناوبات">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22">
                        <TextBlock Text="فتح المناوبات وإقفالها ومطابقة النقدية" FontSize="22" FontWeight="Bold" Foreground="#173F53" Margin="0,0,0,18"/>
                        <GroupBox x:Name="OpenShiftForm" Header="فتح مناوبة" FontWeight="SemiBold" Padding="13" Margin="0,0,0,20">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="الصندوق" VerticalAlignment="Center"/>
                                <ComboBox x:Name="OpenDeskCombo" Width="280" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                                <TextBlock Text="الرصيد الافتتاحي" VerticalAlignment="Center"/>
                                <TextBox x:Name="OpeningCashBox" Width="155" FlowDirection="LeftToRight" Text="0" Language="en-US"/>
                                <Button Content="فتح المناوبة" Click="OpenShift_Click"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox x:Name="CloseShiftForm" Header="إقفال المناوبة" FontWeight="SemiBold" Padding="13">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="المناوبة" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="CloseShiftCombo" Width="300" DisplayMemberPath="Display" SelectedValuePath="Id"/>
                                    <TextBlock Text="النقد الفعلي" VerticalAlignment="Center"/>
                                    <TextBox x:Name="CountedCashBox" Width="150" FlowDirection="LeftToRight" Language="en-US"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <TextBlock Text="ملاحظة الفروقات" VerticalAlignment="Center"/>
                                    <TextBox x:Name="CloseCommentBox" Width="440"/>
                                    <Button Content="إقفال ومطابقة" Click="CloseShift_Click" Background="#9F5730"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="ReceiptsTab" Header="التحصيل">
                <StackPanel Margin="25">
                    <TextBlock Text="تحصيل دفعة على فاتورة" FontSize="22" FontWeight="Bold" Foreground="#173F53" Margin="0,0,0,20"/>
                    <TextBlock Text="اختر الفاتورة"/>
                    <ComboBox x:Name="ReceiptInvoiceCombo" Width="560" HorizontalAlignment="Right" DisplayMemberPath="Display" SelectedValuePath="Id"/>
                    <TextBlock Text="المناوبة المفتوحة لحسابك" Margin="0,15,0,0"/>
                    <ComboBox x:Name="ReceiptShiftCombo" Width="380" HorizontalAlignment="Right" DisplayMemberPath="Display" SelectedValuePath="Id"/>
                    <TextBlock Text="قيمة الدفعة" Margin="0,15,0,0"/>
                    <TextBox x:Name="ReceiptAmountBox" Width="180" HorizontalAlignment="Right" FlowDirection="LeftToRight" Language="en-US"/>
                    <Button Content="تسجيل سند قبض" Width="210" HorizontalAlignment="Right" Click="CreateReceipt_Click" Margin="4,20"/>
                </StackPanel>
            </TabItem>
            <TabItem x:Name="ExpensesTab" Header="المصروفات">
                <StackPanel Margin="25">
                    <TextBlock Text="تسجيل مصروف نقدي" FontSize="22" FontWeight="Bold" Foreground="#173F53" Margin="0,0,0,20"/>
                    <TextBlock Text="المناوبة المفتوحة لحسابك"/>
                    <ComboBox x:Name="ExpenseShiftCombo" Width="420" HorizontalAlignment="Right" DisplayMemberPath="Display" SelectedValuePath="Id"/>
                    <TextBlock Text="فئة المصروف" Margin="0,12,0,0"/>
                    <TextBox x:Name="ExpenseCategoryBox" Width="330" HorizontalAlignment="Right"/>
                    <TextBlock Text="البيان" Margin="0,12,0,0"/>
                    <TextBox x:Name="ExpenseDescriptionBox" Width="520" HorizontalAlignment="Right"/>
                    <TextBlock Text="المبلغ" Margin="0,12,0,0"/>
                    <TextBox x:Name="ExpenseAmountBox" Width="175" FlowDirection="LeftToRight" HorizontalAlignment="Right" Language="en-US"/>
                    <Button Content="تسجيل سند صرف" Width="220" HorizontalAlignment="Right" Click="AddExpense_Click" Margin="4,20"/>
                </StackPanel>
            </TabItem>
            <TabItem x:Name="AdminTab" Header="الإدارة والصلاحيات">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="23">
                        <TextBlock Text="إعداد المستخدمين والصناديق" FontSize="22" FontWeight="Bold" Foreground="#173F53" Margin="0,0,0,17"/>
                        <GroupBox x:Name="DeskGroup" Header="إنشاء صندوق" Padding="14" Margin="0,0,0,17">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="اسم الصندوق" VerticalAlignment="Center"/>
                                <TextBox x:Name="NewDeskBox" Width="270"/>
                                <Button Content="إضافة صندوق" Click="AddDesk_Click"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox x:Name="ManageUsersGroup" Header="المستخدمون والأقسام والصلاحيات" Padding="14" Margin="0,0,0,17">
                            <StackPanel>
                                <TextBlock Text="ينشئ مسؤول البرنامج المستخدمين ويحدد القسم وصلاحيات العرض والإضافة والتعديل والاعتماد لكل مستخدم."
                                           TextWrapping="Wrap" Margin="0,0,0,12"/>
                                <Button Content="فتح إدارة المستخدمين والأقسام" Width="260" HorizontalAlignment="Right"
                                        Click="ManageUsers_Click" Background="#227B8B"/>
                            </StackPanel>
                        </GroupBox>
                        <TextBlock Text="للأمان: ينشئ المدير الحسابات، ولا تظهر كلمات المرور في التقارير أو سجلات العمليات." Foreground="#607D8E" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

<Style x:Key="MedicalCard" TargetType="{x:Type Border}"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource MedicalLine}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="15"/><Setter Property="Padding" Value="17"/><Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#183C4B" Opacity="0.08" ShadowDepth="2" BlurRadius="12"/></Setter.Value></Setter></Style>
<Style x:Key="MedicalMetricCard" TargetType="{x:Type Border}" BasedOn="{StaticResource MedicalCard}"><Setter Property="Padding" Value="22"/><Setter Property="Margin" Value="7"/></Style>
</ResourceDictionary>
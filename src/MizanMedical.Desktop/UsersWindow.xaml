<Window x:Class="MizanMedical.Desktop.UsersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ميزان الطبي — الأقسام والمستخدمون والصلاحيات"
        Width="1170" Height="800" MinWidth="980" MinHeight="670"
        WindowStartupLocation="CenterOwner" Background="{StaticResource MedicalCanvas}"
        FlowDirection="RightToLeft" FontFamily="Segoe UI" Loaded="Window_Loaded">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,15">
            <TextBlock Text="إدارة الأقسام والمستخدمين والصلاحيات" FontSize="23" FontWeight="Bold" Foreground="#173F53"/>
            <TextBlock Text="المسؤول الأساسي وحده ينشئ الحسابات ويمنح الوصول إلى قسم واحد أو جميع الأقسام. لا تمنح أسماء الأدوار صلاحيات تلقائية."
                       TextWrapping="Wrap" Foreground="#58717B" Margin="0,7"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource MedicalCard}" Padding="17" Margin="0,0,10,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="حسابات الموظفين" FontSize="18" FontWeight="SemiBold"/>
                        <Button Content="مستخدم جديد" Click="NewUser_Click" HorizontalAlignment="Right" Width="130" Margin="0,8,0,0"/>
                    </StackPanel>
                    <DataGrid x:Name="UsersGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                              SelectionChanged="UsersGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="اسم الدخول" Binding="{Binding Username}" Width="*"/>
                            <DataGridTextColumn Header="الاسم" Binding="{Binding FullName}" Width="2*"/>
                            <DataGridTextColumn Header="القسم" Binding="{Binding DepartmentName}" Width="130"/>
                            <DataGridCheckBoxColumn Header="نشط" Binding="{Binding IsActive}" Width="65"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource MedicalCard}" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="بيانات المستخدم ونطاق القسم" FontSize="19" FontWeight="Bold" Margin="0,0,0,12"/>
                        <TextBlock Text="اسم الدخول (إنجليزي، ثابت بعد الإنشاء)"/>
                        <TextBox x:Name="UsernameBox" Margin="0,3,0,10" FlowDirection="LeftToRight"/>
                        <TextBlock Text="اسم الموظف"/>
                        <TextBox x:Name="FullNameBox" Margin="0,3,0,10"/>
                        <TextBlock Text="الدور الوظيفي — للتصنيف فقط"/>
                        <ComboBox x:Name="RoleCombo" Width="320" HorizontalAlignment="Right" Margin="0,3,0,10"
                                  DisplayMemberPath="Name" SelectedValuePath="Key"/>
                        <TextBlock Text="قسم الموظف"/>
                        <ComboBox x:Name="DepartmentCombo" DisplayMemberPath="Name" SelectedValuePath="Id"
                                  HorizontalAlignment="Right" Width="330" Margin="0,3,0,10"/>
                        <CheckBox x:Name="AllDepartmentsBox" Content="صلاحية العمل في جميع الأقسام (حسب الحقوق المحددة أدناه)"
                                  Checked="ScopeChanged" Unchecked="ScopeChanged" Margin="0,5,0,7"/>
                        <CheckBox x:Name="ActiveBox" Content="الحساب نشط" IsChecked="True" Margin="0,5,0,10"/>
                        <TextBlock Text="كلمة المرور (عند إنشاء الحساب فقط، 12 حرفا على الأقل)"/>
                        <PasswordBox x:Name="PasswordBox" Margin="0,3,0,8"/>
                        <TextBlock Text="الصلاحيات التفصيلية" FontSize="16" FontWeight="Bold" Margin="0,12,0,7"/>
                        <Border BorderBrush="{StaticResource MedicalLine}" BorderThickness="1" CornerRadius="10" Padding="12" MaxHeight="210">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="GrantsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Label}" IsChecked="{Binding Selected,Mode=TwoWay}"
                                                      Margin="0,3"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                        <WrapPanel Margin="0,13,0,8">
                            <Button x:Name="SaveUserButton" Content="حفظ المستخدم والصلاحيات" Click="Save_Click" Background="#176D86"/>
                            <Button Content="إعادة تعيين كلمة المرور" Click="ResetPassword_Click" Background="#7C677B"/>
                            <Button Content="تحديث" Click="Refresh_Click"/>
                        </WrapPanel>
                        <Separator Margin="0,12"/>
                        <TextBlock Text="حد المستخدمين النشطين لكل قسم" FontSize="16" FontWeight="Bold" Margin="0,0,0,7"/>
                        <WrapPanel Margin="0,0,0,10"><ComboBox x:Name="LimitDepartmentCombo" DisplayMemberPath="Name" SelectedValuePath="Id" Width="210" SelectionChanged="LimitDepartment_SelectionChanged"/><TextBox x:Name="DepartmentLimitBox" Width="80" Text="20" FlowDirection="LeftToRight"/><Button Content="تحديث الحد" Click="UpdateDepartmentLimit_Click"/></WrapPanel>
                        <TextBlock Text="إضافة قسم جديد" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                        <WrapPanel>
                            <TextBox x:Name="DepartmentCodeBox" Width="90" FlowDirection="LeftToRight" ToolTip="رمز القسم مثل LAB"/>
                            <TextBox x:Name="DepartmentNameBox" Width="190" ToolTip="اسم القسم بالعربية"/><TextBox x:Name="NewDepartmentLimitBox" Width="65" Text="20" FlowDirection="LeftToRight" ToolTip="عدد المستخدمين المسموح"/>
                            <Button Content="إضافة قسم" Click="AddDepartment_Click"/>
                        </WrapPanel>
                        <Button Content="تهيئة صندوق خاص للمستخدم المحدد (الحسابات القديمة)" Click="ProvisionDesk_Click" Margin="0,12,0,0" HorizontalAlignment="Right" Background="#397B74"/>
                        <TextBlock Text="لكل موظف مرتبط بقسم صندوق نقدي مستقل يُنشأ آليا؛ مسؤولو جميع الأقسام للرقابة فقط." TextWrapping="Wrap" Foreground="#58717B" Margin="0,8"/>
                        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="#325F6E" Margin="0,14,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
